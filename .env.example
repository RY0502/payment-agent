# LangChain Agent Environment Variables
# Copy this file to .env and fill in your API keys

# ============================================
# Model Provider API Keys (REQUIRED)
# ============================================

# Groq API Key (REQUIRED for the tool-calling ReAct agent in agent.ts)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# ============================================
# Vision Providers (@freetier/orchestrator)
# ============================================
# vision.ts uses @freetier/orchestrator to call vision-capable LLMs with
# automatic failover across providers when a free-tier key is rate-limited
# or exhausted. GROQ_API_KEY above is reused as one of the providers.
# Add any of the additional keys below to add more providers to the failover
# chain (priority order is Cloudflare -> NVIDIA -> Groq, see src/vision.ts).

# Cloudflare Workers AI (optional additional vision provider)
# Get a token at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here

# NVIDIA NIM (optional additional vision provider)
# Get your key at: https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here

# Override the default vision model used per provider.
# NOTE: meta-llama/llama-4-scout-17b-16e-instruct (the orchestrator's default Groq
# vision model) has been decommissioned by Groq specifically. Override it here to a
# supported model. Cloudflare's default (llama-4-scout) is NOT decommissioned, so
# leave CLOUDFLARE_VISION_MODEL unset unless you have a specific reason to override it.
GROQ_VISION_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
# CLOUDFLARE_VISION_MODEL=@cf/meta/llama-4-maverick-17b-128e-instruct

# ============================================
# Optional: LangSmith for Tracing & Debugging
# ============================================

# Enable LangSmith tracing (recommended for development)
# Sign up at: https://smith.langchain.com/
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=payment-agent

# ============================================
# Payment Notification Settings (OPTIONAL)
# ============================================

# Supabase Anon Key for payment notification
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# URL to send payment notifications (QR code URL, amount, account number)
# This will push the payment details to user's phone
PAYMENT_NOTIFICATION_URL=https://your-supabase-function-url

# ============================================
# Mailgun Email Settings (OPTIONAL)
# ============================================

# Mailgun API Key (for sending payment success emails)
# Get your key at: https://app.mailgun.com/app/account/security/api_keys
MAILGUN_API_KEY=your-mailgun-api-key-here

# Mailgun Domain (your verified sending domain)
MAILGUN_DOMAIN=your-mailgun-domain.mailgun.org

# Email address to send payment success notifications from
MAILGUN_FROM_EMAIL=Payment Agent <noreply@your-domain.com>

# Email address to send payment success notifications to (optional fallback)
# Note: The recipient email is primarily taken from the user's prompt (paymentData.email)
# This fallback is only used if no email is provided in the prompt
MAILGUN_TO_EMAIL=your-email@example.com

# ============================================
# Environment Configuration
# ============================================

# Set to 'production' for production environment
NODE_ENV=production

# Set to 'true' to run browser in headless mode (required for Vercel)
HEADLESS=true
