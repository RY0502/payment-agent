{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    }
  ],
  "functions": {
    "api/payment.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/health.ts": {
      "maxDuration": 10,
      "memory": 128
    }
  },
  "env": {
    "NODE_ENV": "production",
    "HEADLESS": "true"
  }
}
